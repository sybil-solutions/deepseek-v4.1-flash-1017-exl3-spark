 def _dequant_block_fp8(w: torch.Tensor, s: torch.Tensor) -> torch.Tensor:
     ob, ib = w.size(0) // s.size(0), w.size(1) // s.size(1)
     x = w.unflatten(0, (-1, ob)).unflatten(-1, (-1, ib)).float() * s[:, None, :, None].float()
