+def _read_host(path: str, off: int, rows: int, cols: int, chunk: int = 256 << 20) -> torch.Tensor:
+    """One 1-byte-per-element tensor read straight into (unpinned) host memory: no staging copy, so a ~98 GB Engram
+    table needs ~98 GB of RAM, not twice that."""
+    t = torch.empty(rows, cols, dtype=torch.uint8, device="cpu")
+    mv, n, got = memoryview(t.numpy()).cast("B"), rows * cols, 0
+    with open(path, "rb", buffering=0) as f:
+        f.seek(off)
+        while got < n:
+            r = f.readinto(mv[got: min(n, got + chunk)])
+            if not r:
+                raise IOError(f"short read {path} @ {off + got}")
+            got += r
+    return t
+
