diff --git a/scripts/quantize/caldata/generate_muse.py b/scripts/quantize/caldata/generate_muse.py
new file mode 100644
index 0000000..5c40ef4
--- /dev/null
+++ b/scripts/quantize/caldata/generate_muse.py
@@ -0,0 +1,103 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Native DeepSeek-V4.1-Flash-1017 replies for the Muse calibration prompts (owner composition: agentic 35 / coding 25 /
+religion + philosophy 20 / multilingual 10 / structured 10), from a local OpenAI-compatible server on the native
+weights. Agentic traces keep their recorded context up to the last user or tool message and get one native assistant
+turn; prompts get a full native reply. Wikipedia documents pass through as text. No output cap. Resumable.
+
+  GEN_URL=http://127.0.0.1:8000/v1/chat/completions GEN_MODEL=deepseek-v4.1-flash \
+    python3 generate_muse.py muse_cal_prompts.jsonl muse_1017.jsonl [--workers 16]
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+import os
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+
+from generate import assistant_message, post
+
+URL_MODEL = os.environ.get("GEN_MODEL", "deepseek-v4.1-flash")
+lock = threading.Lock()
+
+
+def lit(v):
+    return ast.literal_eval(v) if isinstance(v, str) else v
+
+
+def normalize(r):
+    """OpenAI-shaped messages + tools from a Muse record (stringified lists, tools on the first message)."""
+    msgs, tools = [], None
+    for m in r["messages"]:
+        m = dict(m)
+        if "tools" in m:
+            tools = lit(m.pop("tools")) or tools
+        if "tool_calls" in m:
+            m["tool_calls"] = [{"id": t.get("id"), "type": "function",
+                                "function": {"name": t["function"]["name"],
+                                             "arguments": t["function"]["arguments"]
+                                             if isinstance(t["function"]["arguments"], str)
+                                             else json.dumps(t["function"]["arguments"])}}
+                               for t in lit(m["tool_calls"])]
+        if m["role"] == "system" and not m.get("content") and not tools:
+            continue
+        msgs.append(m)
+    if msgs and msgs[0]["role"] == "system" and not msgs[0].get("content"):
+        msgs = msgs[1:]
+    while msgs and msgs[-1]["role"] == "assistant":      # the native turn replaces whatever the trace recorded last
+        msgs.pop()
+    return msgs, tools
+
+
+def run(r):
+    if r["kind"] == "wiki_document":
+        text = "\n\n".join(m.get("content") or "" for m in lit(r["messages"]))
+        return {**{k: r[k] for k in ("id", "domain", "family", "kind")}, "split": "cal", "text": text,
+                "thinking": False, "effort": None, "tools": None, "messages": []}
+    msgs, tools = normalize(r)
+    body = {"model": URL_MODEL, "messages": msgs, "chat_template_kwargs": (
+        {"thinking": True, "reasoning_effort": r["effort"]} if r["thinking"] else {"thinking": False})}
+    if tools:
+        body["tools"] = tools
+    resp = post("local", body, 5)
+    a, fin = assistant_message(resp)
+    return {**{k: r[k] for k in ("id", "domain", "family", "kind", "thinking", "effort")}, "split": "cal",
+            "tools": tools, "messages": msgs + [a], "meta": {"finish": [fin], "usage": resp.get("usage")}}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("prompts")
+    ap.add_argument("out")
+    ap.add_argument("--workers", type=int, default=16)
+    a = ap.parse_args()
+    items = [json.loads(line) for line in open(a.prompts)]
+    done = set()
+    if os.path.exists(a.out):
+        done = {json.loads(line)["id"] for line in open(a.out)}
+    todo = [it for it in items if it["id"] not in done]
+    print(f"{len(items)} items, {len(done)} done, {len(todo)} to go", flush=True)
+    t0, ok, err = time.time(), 0, 0
+    with open(a.out, "a") as f, ThreadPoolExecutor(a.workers) as ex:
+        futs = {ex.submit(run, it): it for it in todo}
+        for fut in futs:
+            it = futs[fut]
+            try:
+                rec = fut.result()
+            except Exception as e:  # noqa: BLE001
+                err += 1
+                print(f"[err] {it['id']} {it['domain']}: {str(e)[:200]}", flush=True)
+                continue
+            with lock:
+                f.write(json.dumps(rec, ensure_ascii=False) + "\n")
+                f.flush()
+            ok += 1
+            if ok % 20 == 0:
+                print(f"{ok} ok, {err} err, {time.time() - t0:.0f}s", flush=True)
+    print(f"DONE {ok} ok, {err} err, {time.time() - t0:.0f}s", flush=True)
+
+
+if __name__ == "__main__":
+    main()
