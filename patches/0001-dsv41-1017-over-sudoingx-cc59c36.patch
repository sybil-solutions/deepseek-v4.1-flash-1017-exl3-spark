index 0000000..c9ca44e
--- /dev/null
+++ b/scripts/quantize/caldata/build_1017.py
@@ -0,0 +1,137 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Calibration token set for DeepSeek-V4.1-Flash-1017 at the owner composition: agentic 35 / coding 25 /
+religion + philosophy 20 / multilingual 10 / structured 10 (token shares), plus random-token rows (outside the
+families, as in build.py) so rarely routed experts still see inputs.
+
+Sources: generate_muse.py's native replies to the Muse calibration prompts (records carry `family`), and generate.py's
+native replies to sudoingx's base prompts (split "cal" only; the "panel" split stays out of calibration). Conversations
+are rendered with the checkpoint's own encoder (build.make_encoder) and cut into --window token windows; for agentic
+traces the window holding the native final turn is always taken first. Wikipedia documents are tokenized as plain
+text. exllamav3's standard calibration text tops up a family only when its native pool is short.
+
+  python3 build_1017.py /model muse_1017.jsonl base_1017.jsonl /std_cal_dir /out [--tokens 1200000 --window 2048]
+
+Writes cal.safetensors (tokens int32, offsets int64) and cal_index.json (source, id, domain = family, length), the
+format p4_pass0.py / p4_pass1.py read.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import random
+
+import torch
+from safetensors.torch import save_file
+
+from build import make_encoder, pack
+
+SEED = 20261017
+SHARES = {"agentic": 0.35, "coding": 0.25, "religion_philosophy": 0.20, "multilingual": 0.10, "structured": 0.10}
+BASE_FAMILY = {"code": "coding", "code_debug": "coding", "math": "coding", "agentic": "agentic",
+               "knowledge": "religion_philosophy", "writing": "religion_philosophy", "chat": "structured"}
+STD_FAMILY = {"code.utf8": "coding", "multilingual.utf8": "multilingual", "wiki.utf8": "religion_philosophy",
+              "technical.utf8": "structured", "c4.utf8": "structured"}
+
+
+def base_family(domain):
+    if domain.startswith("multilingual"):
+        return "multilingual"
+    return BASE_FAMILY.get(domain, "structured")
+
+
+def windows(ids, w, min_len, tail_first):
+    out = [ids[s: s + w] for s in range(0, len(ids), w)]
+    out = [x for x in out if len(x) >= min_len] or [ids[-w:]]
+    if tail_first:
+        out = [ids[-w:]] + [x for x in out[:-1]]          # the window that ends on the native turn
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("model")
+    ap.add_argument("muse")
+    ap.add_argument("base")
+    ap.add_argument("std_dir")
+    ap.add_argument("out")
+    ap.add_argument("--tokens", type=int, default=1_200_000)
+    ap.add_argument("--window", type=int, default=2048)
+    ap.add_argument("--min-len", type=int, default=256)
+    ap.add_argument("--random-rows", type=int, default=8)
+    a = ap.parse_args()
+    tok, encode = make_encoder(a.model)
+    rng = random.Random(SEED)
+
+    pools = {f: [] for f in SHARES}                        # family -> [(priority, ids, meta)]
+    for line in open(a.muse):
+        r = json.loads(line)
+        if r.get("text"):
+            ids = tok.encode(r["text"], add_special_tokens=False).ids
+            for i, x in enumerate(windows(ids, a.window, a.min_len, False)):
+                pools[r["family"]].append((1 + i, x, {"source": "muse_wiki", "id": r["id"], "sub": r["domain"]}))
+            continue
+        ids, _ = encode(r)
+        agentic = r["family"] == "agentic"
+        for i, x in enumerate(windows(ids, a.window, a.min_len, agentic)):
+            pools[r["family"]].append((i, x, {"source": "muse_native", "id": r["id"], "sub": r["domain"]}))
+    for line in open(a.base):
+        r = json.loads(line)
+        if r["split"] != "cal":
+            continue
+        fam = base_family(r["domain"])
+        ids, _ = encode(r)
+        for i, x in enumerate(windows(ids, a.window, a.min_len, fam == "agentic")):
+            pools[fam].append((i, x, {"source": "base_native", "id": r["id"], "sub": r["domain"]}))
+
+    std = {}
+    for fname, fam in STD_FAMILY.items():
+        with open(os.path.join(a.std_dir, fname), encoding="utf8") as f:
+            std[fname] = (fam, tok.encode(f.read(), add_special_tokens=False).ids)
+
+    cal, idx, report = [], [], {}
+    for fam, share in SHARES.items():
+        quota = int(a.tokens * share)
+        pool = pools[fam]
+        rng.shuffle(pool)
+        pool.sort(key=lambda p: p[0])                      # first / tail windows of every conversation before later ones
+        got = 0
+        for _, x, meta in pool:
+            if got >= quota:
+                break
+            x = x[: quota - got] if quota - got < len(x) and quota - got >= a.min_len else x
+            cal.append(x)
+            idx.append({**meta, "domain": fam, "length": len(x)})
+            got += len(x)
+        native = got
+        for fname, (sfam, ids) in std.items():
+            while sfam == fam and got < quota:
+                s = rng.randrange(0, max(1, len(ids) - a.window))
+                x = ids[s: s + min(a.window, quota - got)]
+                cal.append(x)
+                idx.append({"source": "exllamav3_std", "id": f"{fname}@{s}", "sub": fname, "domain": fam,
+                            "length": len(x)})
+                got += len(x)
+        report[fam] = {"quota": quota, "tokens": got, "native": native, "pool_tokens": sum(len(p[1]) for p in pool),
+                       "pool_conversations": len({p[2]["id"] for p in pool})}
+
+    vocab = tok.get_vocab_size()
+    g = torch.Generator().manual_seed(SEED)
+    for i in range(a.random_rows):
+        cal.append(torch.randint(0, vocab, (a.window,), generator=g).tolist())
+        idx.append({"source": "random", "id": f"random{i}", "sub": "random", "domain": "random", "length": a.window})
+
+    os.makedirs(a.out, exist_ok=True)
+    t, o = pack(cal)
+    save_file({"tokens": t, "offsets": o}, os.path.join(a.out, "cal.safetensors"))
+    json.dump(idx, open(os.path.join(a.out, "cal_index.json"), "w"), indent=0)
+    total = sum(x["length"] for x in idx)
+    fam_tokens = {f: sum(x["length"] for x in idx if x["domain"] == f) for f in list(SHARES) + ["random"]}
+    report["_total"] = {"sequences": len(cal), "tokens": total,
+                        "shares": {f: round(v / total, 4) for f, v in fam_tokens.items()}}
+    json.dump(report, open(os.path.join(a.out, "cal_report.json"), "w"), indent=1)
+    print(json.dumps(report, indent=1))
+
+
+if __name__ == "__main__":
+    main()
